NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/bezreszty.sqlite
DEMO_MODE=false
# Adresy losowych aliasów muszą trafiać na dedykowaną skrzynkę IMAP.
NOTIFICATION_DOMAIN=powiadomienia.twojadomena.pl
OPERATOR_NAME=Operator instancji BezReszty
OPERATOR_EMAIL=kontakt@twojadomena.pl
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BezReszty <noreply@twojadomena.pl>
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
BANK_DKIM_DOMAINS=alior.pl,aliorbank.pl
# 1 tylko za jednym zaufanym reverse proxy; port aplikacji nie może być publiczny.
TRUST_PROXY=0
