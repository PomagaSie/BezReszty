<%- include('partials/head') %><main id="main" class="shell section"><div class="page-heading"><span class="eyebrow">ODPOWIEDZIALNE POMAGANIE</span><h1>Panel operatora.</h1><p>Weryfikacja organizatorów, publikacja zbiórek i wyjaśnianie powiadomień.</p></div><h2>Organizatorzy</h2><% organizers.forEach(o => { %><section class="admin-card"><div><span class="badge"><%= o.verification_status %></span><h3><%= o.name %></h3><p><%= o.email %> · E-mail <%= o.email_verified ? 'potwierdzony' : 'niepotwierdzony' %></p><p>Telefon BLIK: <strong><%= o.phone %></strong><br>Rachunek: <code><%= o.iban %></code></p><p>Powiadomienie testowe: <strong><%= o.bank_notification_seen ? 'odebrane i uwierzytelnione' : 'brak' %></strong></p><p class="fine-print">Przed zatwierdzeniem sprawdź tożsamość właściciela, własność rachunku i powiązanie telefonu BLIK zgodnie z docs/VERIFICATION.md. Sam test poczty nie wystarcza.</p></div><form action="/admin/organizator/<%= o.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label for="note-<%= o.id %>">Uzasadnienie / wynik sprawdzenia (bez kopii dokumentów)</label><textarea id="note-<%= o.id %>" name="note" required minlength="10" maxlength="1000" rows="3"></textarea><div class="editor-buttons"><% if(o.verification_status==='pending') { %><button class="button" type="submit" name="action" value="verify" <%= !o.email_verified || !o.bank_notification_seen ? 'disabled' : '' %>>Zatwierdź</button><button class="button secondary" type="submit" name="action" value="reject">Odrzuć</button><% } else { %><button class="button secondary" type="submit" name="action" value="suspend">Wstrzymaj organizatora</button><% } %></div></form></section><% }) %><% if(!organizers.length) { %><p class="muted">Brak zgłoszeń organizatorów.</p><% } %><h2>Zbiórki do publikacji</h2><% campaigns.forEach(c => { %><section class="admin-card"><div><h3><a href="/zbiorka/<%= c.slug %>"><%= c.title %> ↗</a></h3><p><%= c.organizer %> · <%= money(c.goal) %></p><p><%= c.summary %></p></div><form action="/admin/zbiorka/<%= c.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><p>Przeczytaj pełny opis zbiórki przed publikacją.</p><div class="editor-buttons"><button class="button" type="submit" name="action" value="publish">Opublikuj</button><button class="button secondary" type="submit" name="action" value="reject">Odeślij do poprawy</button></div></form></section><% }) %><% if(!campaigns.length) { %><p class="muted">Wszystkie zgłoszenia są rozpatrzone.</p><% } %><h2>Powiadomienia do wyjaśnienia</h2><p class="muted">Kwarantanna nie zwiększa sum zbiórek. Nie zatwierdzaj wpłaty na podstawie niezweryfikowanego e-maila.</p><div class="table-wrap"><table><thead><tr><th>Data</th><th>Organizator</th><th>Kwota / tytuł</th><th>Powód</th></tr></thead><tbody><% messages.forEach(m => { %><tr><td><%= new Date(m.received_at).toLocaleString('pl-PL', {timeZone:'Europe/Warsaw'}) %></td><td><%= m.organizer || '—' %></td><td><%= m.amount ? money(m.amount) : '—' %><small><%= m.title || '—' %></small></td><td><code><%= m.reason %></code></td></tr><% }) %></tbody></table></div><h2 class="section-small">Dziennik operacji</h2><div class="table-wrap"><table><thead><tr><th>Data</th><th>Kto</th><th>Operacja</th><th>Uwagi</th></tr></thead><tbody><% audits.forEach(a => { %><tr><td><%= new Date(a.created_at).toLocaleString('pl-PL', {timeZone:'Europe/Warsaw'}) %></td><td><%= a.actor || 'System' %></td><td><code><%= a.action %></code></td><td><%= a.note %></td></tr><% }) %></tbody></table></div></main><%- include('partials/footer') %>
