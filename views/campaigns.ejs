<%- include('partials/head') %><main id="main" class="shell section"><div class="page-heading"><span class="eyebrow">KAŻDA SPRAWA MA ZNACZENIE</span><h1>Komu dziś pomożesz?</h1><p>Znajdź cel, który jest Ci bliski. Twoja pomoc trafia w całości do organizatora.</p></div><form action="/zbiorki" method="get" class="search-form"><label class="sr-only" for="q">Szukaj zbiórki</label><input id="q" type="search" name="q" placeholder="Szukaj po nazwie, celu lub miejscowości…" value="<%= search %>"><label class="sr-only" for="category">Kategoria</label><select name="kategoria" id="category"><option value="">Wszystkie kategorie</option><% Object.entries(categories).forEach(([key,label]) => { %><option value="<%= key %>" <%= category === key ? 'selected' : '' %>><%= label %></option><% }) %></select><button class="button" type="submit">Szukaj <span aria-hidden="true">↗</span></button></form><div class="results-heading"><strong><%= count %> <%= count === 1 ? 'zbiórka' : 'zbiórek' %></strong><span>Razem możemy więcej.</span></div><% if(campaigns.length) { %><div class="campaign-grid"><% campaigns.forEach(campaign => { %><%- include('partials/card',{campaign}) %><% }) %></div><nav class="pagination" aria-label="Strony wyników"><% if(page > 1) { %><a class="button secondary" href="/zbiorki?<%= new URLSearchParams({q:search,kategoria:category,strona:String(page-1)}) %>">← Poprzednie</a><% } %><% if(page*12 < count) { %><a class="button secondary" href="/zbiorki?<%= new URLSearchParams({q:search,kategoria:category,strona:String(page+1)}) %>">Następne →</a><% } %></nav><% } else { %><div class="empty-state centered"><span class="empty-symbol">✧</span><h2><%= search || category ? 'Nie znaleźliśmy takiej sprawy.' : 'Tu zaczyna się coś dobrego.' %></h2><p><%= search || category ? 'Spróbuj innego hasła lub zobacz wszystkie zbiórki.' : 'Czekamy na pierwsze zweryfikowane zbiórki. Dołącz jako organizator.' %></p><a class="button" href="<%= search || category ? '/zbiorki' : '/rejestracja' %>"><%= search || category ? 'Pokaż wszystkie' : 'Załóż zbiórkę' %> ↗</a></div><% } %></main><%- include('partials/footer') %>
