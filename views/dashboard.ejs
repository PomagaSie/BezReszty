<%- include('partials/head') %><main id="main" class="shell section dashboard"><div class="section-heading"><div><span class="eyebrow">TWOJE CENTRUM POMAGANIA</span><h1>Cześć, <%= user.name.split(' ')[0] %></h1><p class="muted">Dobre sprawy są w dobrych rękach.</p><a class="text-link" href="/panel/bezpieczenstwo">Bezpieczeństwo konta i 2FA →</a></div><a class="button" href="/panel/nowa-zbiorka">Nowa zbiórka <span>+</span></a></div><%- include('partials/mobywatel') %><% if(user.verification_status !== 'verified') { %><section class="onboarding"><div><span class="eyebrow">ZANIM ZACZNIEMY ZBIERAĆ</span><h2>Przygotuj swoje konto</h2><p>Sprawdzamy organizatorów, żeby pomaganie było bardziej przejrzyste. Szkic zbiórki możesz przygotować już teraz.</p></div><ol class="checklist"><li><span class="step-check <%= user.email_verified ? 'done' : '' %>"><%= user.email_verified ? '✓' : '1' %></span><div><strong>Potwierdź adres e-mail</strong><p><%= user.email_verified ? user.email : 'Otwórz wiadomość wysłaną na ' + user.email %></p><% if(!user.email_verified) { %><form action="/panel/email" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit">Wyślij wiadomość ponownie →</button></form><% } %></div></li><li><span class="step-check <%= ['pending','verified'].includes(user.verification_status) ? 'done' : '' %>"><%= ['pending','verified'].includes(user.verification_status) ? '✓' : '2' %></span><div><strong>Połącz konto Alior Banku</strong><p>Podaj rachunek i numer BLIK. Ustaw powiadomienia na swój indywidualny adres.</p><a href="/panel/weryfikacja" class="text-link">Dane i instrukcja konfiguracji →</a></div></li><li><span class="step-check">3</span><div><strong>Przejdź weryfikację operatora</strong><p><%= user.verification_status === 'pending' ? 'Twoje zgłoszenie czeka na sprawdzenie. Operator zadzwoni do Ciebie, potwierdzi dane właściciela rachunku i numeru BLIK oraz poprosi o potwierdzenie tożsamości w aplikacji mObywatel.' : user.verification_status === 'rejected' ? 'Weryfikacja wymaga poprawy. Zobacz uwagi operatora.' : 'Po przesłaniu danych operator sprawdzi Twoje zgłoszenie.' %></p><% if(user.verification_note) { %><p class="alert"><%= user.verification_note %></p><% } %></div></li></ol></section><% } else { %><p class="verified-panel"><span>✓</span> Organizator zweryfikowany <a href="/panel/weryfikacja">Dane i powiadomienia →</a></p><% } %><div class="dashboard-stats"><div><span>Potwierdzona pomoc</span><strong><%= money(stats.raised) %></strong></div><div><span>Wspierające osoby / wpłaty</span><strong><%= stats.supporters %></strong></div><div><span>Twoje zbiórki</span><strong><%= stats.count %></strong></div></div><section><div class="section-heading"><h2>Twoje dobre sprawy</h2></div><% if(campaigns.length) { %><div class="table-wrap"><table><thead><tr><th>Zbiórka</th><th>Status</th><th>Wpłaty / cel</th><th>Działania</th></tr></thead><tbody><% campaigns.forEach(c => { %><tr><td><strong><%= c.title %></strong><small><%= categories[c.category] %></small></td><td><span class="badge <%= c.status==='published' ? 'green' : '' %>"><%= statuses[c.status] %></span></td><td><%= money(c.raised) %><small>z <%= money(c.goal) %></small></td><td><div class="table-actions"><a href="/zbiorka/<%= c.slug %>">Podgląd ↗</a><a href="/panel/zbiorki/<%= c.id %>/edytuj">Edytuj</a><% if(c.status!=='closed') { %><form action="/panel/zbiorki/<%= c.id %>/zamknij" method="post" data-confirm="Zakończyć zbiórkę i wyłączyć nowe wpłaty?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit">Zakończ</button></form><% } %></div></td></tr><% }) %></tbody></table></div><nav class="pagination" aria-label="Strony Twoich zbiórek"><% if(page > 1) { %><a class="button secondary" href="/panel?strona=<%= page-1 %>">← Poprzednie</a><% } %><% if(page*12 < stats.count) { %><a class="button secondary" href="/panel?strona=<%= page+1 %>">Następne →</a><% } %></nav><% } else { %><div class="empty-state"><span class="empty-symbol">♡</span><div><h3>Tu jest miejsce na Twój cel</h3><p>Opisz swoją sprawę i zapisz pierwszy szkic.</p></div><a class="button secondary" href="/panel/nowa-zbiorka">Stwórz zbiórkę →</a></div><% } %></section><section class="section-small"><h2>Ostatnie potwierdzone wpłaty</h2><% if(donations.length) { %><div class="table-wrap"><table><thead><tr><th>Od kogo</th><th>Zbiórka</th><th>Kwota</th><th>Data</th></tr></thead><tbody><% donations.forEach(d => { %><tr><td><%= d.name %></td><td><a href="/zbiorka/<%= d.slug %>"><%= d.campaign_title %></a></td><td><strong><%= money(d.amount) %></strong></td><td><%= new Date(d.confirmed_at).toLocaleDateString('pl-PL', {timeZone:'Europe/Warsaw'}) %></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">Po dopasowaniu powiadomienia bankowego pojawią się tutaj potwierdzone wpłaty.</p><% } %></section><form action="/wyloguj" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit">Wyloguj się →</button></form></main><%- include('partials/footer') %>
