<% if (campaign.cover_media_id) { %>
<img src="/media/<%= campaign.cover_media_id %><%= detail ? '' : '/thumb' %>" alt="<%= detail ? 'Zdjęcie lub ilustracja zbiórki' : '' %>" loading="<%= detail ? 'eager' : 'lazy' %>" decoding="async">
<% } else { %>
<img src="<%= asset('/assets/images/' + campaign.cover + '.svg') %>" alt="<%= detail ? 'Ilustracja kategorii zbiórki' : '' %>" loading="<%= detail ? 'eager' : 'lazy' %>" width="800" height="500">
<% } %>
