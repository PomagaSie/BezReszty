<article class="campaign-card"><a class="card-cover cover-<%= campaign.cover %>" href="/zbiorka/<%= campaign.slug %>" tabindex="-1" aria-hidden="true"><%- include('campaign-cover', { campaign, detail: false }) %><span class="cover-tag"><%= categories[campaign.category] %></span><% if(campaign.is_demo) { %><span class="demo-tag">Przykład</span><% } %></a><div class="card-body"><span class="card-location">⌁ <%= campaign.location %></span><h3><a href="/zbiorka/<%= campaign.slug %>"><%= campaign.title %></a></h3><p class="card-summary"><%= campaign.summary %></p><div class="card-progress"><progress value="<%= Math.min(campaign.raised,campaign.goal) %>" max="<%= campaign.goal %>" aria-label="Postęp zbiórki"></progress><div><strong><%= money(campaign.raised) %></strong><span>z <%= money(campaign.goal) %></span></div></div><div class="card-meta"><span><%= campaign.supporters %> wspierających</span><span class="verified-icon">✓ Sprawdzony organizator</span></div></div></article>
